{
  "name": "manlydude",
  "private": true,
  "scripts": {
    "dev:mobile": "turbo run dev --filter=@manlydude/mobile",
    "dev:web": "turbo run dev --filter=@manlydude/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.9.14",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.0.0"
  }
}
